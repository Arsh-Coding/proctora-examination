# ---------------------------------------------------------------------------
# PROCTORA - environment reference
#
# The apps read their own env files:
#   server/.env   (copy from server/.env.example)
#   client/.env   (copy from client/.env.example)
#
# The API also falls back to this repo-root .env, so for local development you
# can keep the backend values here instead of in server/.env if you prefer.
# ---------------------------------------------------------------------------

# ----------------------------- API (server) --------------------------------
PORT=5000

# MongoDB connection string.
#   local: mongodb://127.0.0.1:27017/proctora
#   atlas: mongodb+srv://<user>:<password>@<cluster>/proctora?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/proctora

# Signs admin JWTs and candidate exam-session tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

JWT_EXPIRES_IN=12h
SESSION_TOKEN_EXPIRES_IN=24h

# Used for CORS, Socket.io origin checks and the exam links printed by the seed.
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# --------------------------- Browser (client) ------------------------------
# These belong in client/.env - only VITE_* names reach the browser.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
