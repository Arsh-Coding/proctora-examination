# ---------------------------------------------------------------------------
# PROCTORA client environment
# Copy to client/.env. Only VITE_* variables are exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL of the PROCTORA API (must include /api).
VITE_API_URL=http://localhost:5000/api

# Socket.io origin (the API host, without /api).
VITE_SOCKET_URL=http://localhost:5000
