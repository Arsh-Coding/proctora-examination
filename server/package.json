{
  "name": "proctora-server",
  "version": "1.0.0",
  "private": true,
  "description": "PROCTORA API server - exams, sessions, scoring and real-time proctoring",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/seed/seed.ts",
    "seed:prod": "node dist/seed/seed.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.20.1",
    "socket.io": "4.8.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.18.9",
    "socket.io-client": "^4.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
