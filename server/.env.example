# ---------------------------------------------------------------------------
# PROCTORA API - server environment
# Copy to server/.env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

PORT=5000

# MongoDB connection string.
#  local:  mongodb://127.0.0.1:27017/proctora
#  atlas:  mongodb+srv://<user>:<password>@<cluster>/proctora?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/proctora

# Secret used to sign admin JWTs and candidate exam-session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Admin login token lifetime.
JWT_EXPIRES_IN=12h

# Candidate exam-session token lifetime (must exceed your longest exam).
SESSION_TOKEN_EXPIRES_IN=24h

# Vite dev server origin. Used for CORS, Socket.io origin checks and exam links.
CLIENT_URL=http://localhost:5173

# Optional: extra allowed origins, comma separated.
# EXTRA_ORIGINS=http://192.168.1.20:5173

NODE_ENV=development

# Rate limiting is skipped in development unless this is "true".
# ENABLE_RATE_LIMIT=true
